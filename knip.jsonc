{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Types stay out: exported schema types are often consumed only through inference.
  "rules": { "types": "off", "nsTypes": "off" },
  "ignoreBinaries": ["vp", "vpx", "electron", "effect-tsgo"],
  "workspaces": {
    ".": {
      // Workflows load the .github/scripts helpers through actions/github-script, and
      // CodeRabbit loads its configuration by filename.
      "entry": ["vite.config.ts", ".github/scripts/*.cjs", ".coderabbit.config.ts"],
      // Keeps the committed dependency sources in .repos out of the root project; the root has
      // no tests of its own, so the Vite and Vitest plugins' test globs would only find theirs.
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "vite": { "entry": ["vite.config.ts"] },
      "vitest": { "entry": [] },
    },
    "apps/server": {
      "entry": ["src/bin.ts", "src/**/*.test.ts"],
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/routes/**/*.tsx", "src/**/*.test.ts"],
      "ignore": ["src/routeTree.gen.ts", "src/components/ui/**"],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@fontsource-variable/inter",
      ],
    },
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.ts"],
    },
    "packages/*": {
      "includeEntryExports": true,
    },
    "oxlint-plugin-toolspell": {
      "entry": ["index.ts", "rules/*.test.ts"],
    },
    "scripts": {
      "entry": ["*.ts", "lib/*.test.ts"],
    },
  },
}
