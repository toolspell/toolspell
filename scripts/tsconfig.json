{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable"],
    // Types the .github/scripts helpers the tests import from their CommonJS source.
    "allowJs": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // Dev scripts are plain Node programs that run before or beside the app.
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalConsole": "off",
          "globalDate": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "processEnvInEffect": "off"
        }
      }
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
